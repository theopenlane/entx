	snake := strcase.SnakeCase(name)

	for _, f := range s.Fields {
		if f.Name != snake && !strings.EqualFold(f.Name, name) {
			continue
		}

		if f.InputKey != "" {
			return f.InputKey, true
		}

		return f.Name, true
	}

	return "", false
}

